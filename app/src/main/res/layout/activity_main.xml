<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F8F7FC" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="wordly." android:textColor="#6558D3" android:textSize="29sp" android:textStyle="bold"/>
            <TextView android:id="@+id/historyButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="History ↺" android:textColor="#6558D3" android:textStyle="bold" android:padding="10dp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="YOUR EVERYDAY WORD COMPANION" android:textColor="#9992AD" android:textSize="10sp"
            android:letterSpacing="0.12" android:layout_marginTop="25dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Discover the meaning\nof every word." android:textColor="#252238" android:textSize="30sp"
            android:textStyle="bold" android:lineSpacingExtra="2dp" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Definitions, pronunciation and more — all in one place."
            android:textColor="#817D91" android:textSize="14sp" android:layout_marginTop="9dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/search_bg"
            android:paddingStart="15dp" android:paddingEnd="7dp" android:layout_marginTop="24dp">
            <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:hint="Search a word..." android:singleLine="true"
                android:background="@android:color/transparent" android:textSize="15sp" android:imeOptions="actionSearch"/>
            <Button android:id="@+id/searchButton" android:layout_width="wrap_content" android:layout_height="46dp"
                android:text="Search" android:textAllCaps="false" android:textColor="#FFFFFF"
                android:backgroundTint="#6558D3"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:visibility="gone" android:layout_marginTop="18dp"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Try a word like “serendipity” or “resilient”."
            android:textColor="#8C879C" android:textSize="13sp" android:gravity="center"
            android:layout_marginTop="20dp"/>
        <LinearLayout android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:background="@drawable/card_bg"
            android:elevation="2dp" android:layout_marginTop="18dp" android:visibility="gone">
            <TextView android:id="@+id/wordText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#252238" android:textSize="27sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="5dp">
                <TextView android:id="@+id/phoneticText" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="#8B849F" android:textSize="14sp"/>
                <Button android:id="@+id/audioButton" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:text="▶  Listen" android:textAllCaps="false" android:textColor="#6558D3"
                    android:backgroundTint="#EEEAFE"/>
            </LinearLayout>
            <TextView android:id="@+id/partText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#6558D3" android:textStyle="bold" android:textSize="12sp"
                android:background="#F0EDFF" android:padding="8dp" android:layout_marginTop="16dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DEFINITION" android:textColor="#A19BAF" android:textSize="10sp"
                android:textStyle="bold" android:letterSpacing="0.12" android:layout_marginTop="20dp"/>
            <TextView android:id="@+id/meaningText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#383449" android:textSize="15sp" android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/exampleText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#8B849F" android:textSize="13sp" android:textStyle="italic"
                android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/synonymText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#6558D3" android:textSize="13sp" android:layout_marginTop="15dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="RECENT SEARCHES" android:textColor="#9992AD" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.12" android:layout_marginTop="28dp"/>
        <TextView android:id="@+id/recentText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Your searched words will appear here." android:textColor="#817D91"
            android:textSize="13sp" android:layout_marginTop="10dp" android:paddingBottom="25dp"/>
    </LinearLayout>
</ScrollView>
